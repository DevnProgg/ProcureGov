<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                            https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">

    <tlib-version>1.0</tlib-version>
    <short-name>lib</short-name>
    <uri>http://library.com/tags</uri>

    <!-- =========================================================
         Custom Tag: badge
         Renders a colored availability status badge
         ========================================================= -->
    <tag>
        <name>badge</name>
        <tag-class>com.library.tags.BadgeTag</tag-class>
        <body-content>empty</body-content>
        <description>Renders a colored badge showing book availability status</description>
        <attribute>
            <name>available</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>boolean</type>
            <description>Whether the book is currently available</description>
        </attribute>
    </tag>

    <!-- =========================================================
         Custom Tag: genreIcon
         Renders an emoji icon representing the book genre
         ========================================================= -->
    <tag>
        <name>genreIcon</name>
        <tag-class>com.library.tags.GenreIconTag</tag-class>
        <body-content>empty</body-content>
        <description>Renders a genre-appropriate icon for the book</description>
        <attribute>
            <name>genre</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.String</type>
            <description>The genre name of the book</description>
        </attribute>
    </tag>

</taglib>
